// Built-in comparisons and arithmetic.
num(1). num(2). num(3). num(4). num(5). num(6).

even(N)      :- num(N), 0 = N % 2.
odd(N)       :- num(N), not even(N).
double(N, M) :- num(N), M = N * 2.
big(N)       :- num(N), N >= 4.
between(N)   :- num(N), N > 1, N < 5.

