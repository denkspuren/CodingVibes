// Thesis Example 3 (Listing 21) - IDB negation chained with recursion.
// safe -> stratum 0, unsafe -> stratum 1, reach -> stratum 2.
// REPL query:  reach(1, Y).
// Expected:    Y = 2, 3   (the step onto unsafe node 4 is rejected)

approved(1). approved(2). approved(3).
node(1). node(2). node(3). node(4).
edge(1, 2). edge(2, 3). edge(3, 4). edge(1, 3).

safe(X)      :- approved(X).
unsafe(X)    :- node(X), not safe(X).
reach(X, Y)  :- edge(X, Y), not unsafe(Y).
reach(X, Z)  :- reach(X, Y), edge(Y, Z), not unsafe(Z).

//test reach(1, Y). => Y=2 ; Y=3
